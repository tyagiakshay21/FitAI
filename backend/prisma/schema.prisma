// FitAI database schema (PostgreSQL + Prisma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────
enum Role {
  USER
  ADMIN
  TRAINER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  WEIGHT_LOSS
  FAT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  BODY_RECOMPOSITION
}

enum DietType {
  VEGETARIAN
  VEGAN
  NON_VEGETARIAN
  EGGETARIAN
}

enum WorkoutLocation {
  GYM
  HOME
  BOTH
}

enum ExerciseCategory {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  CARDIO
  FULL_BODY
  MOBILITY
  STRETCHING
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum FoodRole {
  PROTEIN
  CARB
  VEGETABLE
  FRUIT
  DAIRY
  FAT
  SNACK
  MIXED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum RecommendationType {
  DAILY
  PROGRESS_ANALYSIS
  PLAN_ADAPTATION
  NUTRITION
  WORKOUT
}

enum ChatRole {
  USER
  ASSISTANT
}

enum NotificationType {
  INFO
  ACHIEVEMENT
  REMINDER
}

// ───────────────────────── Auth / users ─────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         Profile?
  subscription    Subscription?
  goals           FitnessGoal[]
  workoutPlans    WorkoutPlan[]
  sessions        WorkoutSession[]
  progress        Progress[]
  measurements    BodyMeasurement[]
  weightLogs      WeightLog[]
  mealPlans       MealPlan[]
  nutritionLogs   NutritionLog[]
  calorieLogs     CalorieLog[]
  waterLogs       WaterLog[]
  sleepLogs       SleepLog[]
  stepLogs        StepLog[]
  achievements    Achievement[]
  recommendations AIRecommendation[]
  analyses        ExerciseAnalysis[]
  notifications   Notification[]
  chatMessages    ChatMessage[]
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  customFoods     Food[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                  String          @id @default(uuid())
  userId              String          @unique
  age                 Int
  gender              Gender
  heightCm            Float
  weightKg            Float
  activityLevel       ActivityLevel   @default(MODERATE)
  experience          ExperienceLevel @default(BEGINNER)
  workoutDaysPerWeek  Int             @default(3)
  workoutDurationMin  Int             @default(60)
  location            WorkoutLocation @default(GYM)
  equipment           String[]
  injuries            String[]
  dietType            DietType        @default(VEGETARIAN)
  allergies           String[]
  foodPreferences     String[]
  dislikedFoods       String[]
  budgetPerDayInr     Int?
  mealsPerDay         Int             @default(4)
  cookingPreference   String          @default("STANDARD")
  stepTarget          Int             @default(8000)
  sleepHours          Float           @default(7.5)
  bodyFatPct          Float?
  onboardingCompleted Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FitnessGoal {
  id             String    @id @default(uuid())
  userId         String
  type           GoalType
  startWeightKg  Float
  targetWeightKg Float?
  startDate      DateTime  @default(now())
  targetDate     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// ───────────────────────── Training ─────────────────────────
model Exercise {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String
  category       ExerciseCategory
  muscleGroups   String[]
  equipment      String[]
  difficulty     Difficulty
  isCompound     Boolean          @default(false)
  instructions   String[]
  defaultSets    Int              @default(3)
  repMin         Int              @default(8)
  repMax         Int              @default(12)
  restSec        Int              @default(90)
  caloriesPerMin Float            @default(5)
  mediaUrl       String?
  safetyNotes    String?
  jointStress    String[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workoutExercises WorkoutExercise[]
  sets             ExerciseSet[]

  @@index([category])
  @@index([difficulty])
}

model WorkoutPlan {
  id          String    @id @default(uuid())
  userId      String
  name        String
  split       String
  weeks       Int       @default(4)
  active      Boolean   @default(true)
  generatedBy String    @default("RULES")
  notes       String?
  progression Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts    Workout[]

  @@index([userId, active])
}

model Workout {
  id               String            @id @default(uuid())
  planId           String
  dayIndex         Int
  dayName          String
  focus            String
  warmup           Json
  cooldown         Json
  estimatedMinutes Int               @default(60)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  plan             WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises        WorkoutExercise[]
  sessions         WorkoutSession[]

  @@unique([planId, dayIndex])
}

model WorkoutExercise {
  id          String   @id @default(uuid())
  workoutId   String
  exerciseId  String
  order       Int
  sets        Int
  repMin      Int
  repMax      Int
  restSec     Int
  tempo       String?
  durationMin Int?
  notes       String?
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId, order])
}

model WorkoutSession {
  id             String        @id @default(uuid())
  userId         String
  workoutId      String?
  date           DateTime      @db.Date
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  durationMin    Int?
  caloriesBurned Float?
  rating         Int?
  notes          String?
  completed      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        Workout?      @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  sets           ExerciseSet[]

  @@index([userId, date])
}

model ExerciseSet {
  id          String         @id @default(uuid())
  sessionId   String
  exerciseId  String
  setNumber   Int
  reps        Int
  weightKg    Float?
  rpe         Float?
  formScore   Float?
  durationSec Int?
  createdAt   DateTime       @default(now())
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([sessionId])
  @@index([exerciseId])
}

model ExerciseAnalysis {
  id               String   @id @default(uuid())
  userId           String
  exerciseName     String
  reps             Int
  targetReps       Int?
  avgFormScore     Float
  breakdown        Json
  feedbackSummary  Json
  durationSec      Int
  caloriesEstimate Float?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Progress / body ─────────────────────────
model Progress {
  id                String   @id @default(uuid())
  userId            String
  weekStart         DateTime @db.Date
  workoutsCompleted Int      @default(0)
  workoutsPlanned   Int      @default(0)
  avgCalories       Float?
  avgProtein        Float?
  avgWeightKg       Float?
  totalVolumeKg     Float?
  consistencyPct    Float?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model BodyMeasurement {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime @db.Date
  waistCm    Float?
  chestCm    Float?
  armsCm     Float?
  thighsCm   Float?
  hipsCm     Float?
  bodyFatPct Float?
  photoUrl   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ───────────────────────── Nutrition ─────────────────────────
model Food {
  id           String     @id @default(uuid())
  name         String
  category     FoodRole
  dietType     DietType // most restrictive diet this food is compatible with
  servingG     Float      @default(100)
  servingLabel String?
  calories     Float // values are per 100 g
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float      @default(0)
  allergens    String[]
  mealTypes    MealType[]
  isIndian     Boolean    @default(true)
  createdById  String? // null = system food
  createdAt    DateTime   @default(now())
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([category])
}

model MealPlan {
  id             String   @id @default(uuid())
  userId         String
  name           String
  targetCalories Int
  targetProtein  Int
  targetCarbs    Int
  targetFat      Int
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals          Meal[]

  @@index([userId, active])
}

model Meal {
  id         String     @id @default(uuid())
  mealPlanId String
  dayIndex   Int        @default(0)
  type       MealType
  name       String
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float      @default(0)
  mealPlan   MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items      MealItem[]

  @@index([mealPlanId, dayIndex])
}

model MealItem {
  id        String  @id @default(uuid())
  mealId    String
  foodId    String?
  foodName  String
  quantityG Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float   @default(0)
  meal      Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model NutritionLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  loggedAt  DateTime @default(now())
  mealType  MealType
  foodId    String?
  foodName  String
  quantityG Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float    @default(0)
  source    String   @default("MANUAL") // MANUAL | DATABASE | AI_PHOTO | MEAL_PLAN
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CalorieLog {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date
  caloriesConsumed Float    @default(0)
  caloriesBurned   Float    @default(0)
  targetCalories   Int?
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  date     DateTime @db.Date
  amountMl Int
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SleepLog {
  id      String   @id @default(uuid())
  userId  String
  date    DateTime @db.Date
  hours   Float
  quality Int?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model StepLog {
  id     String   @id @default(uuid())
  userId String
  date   DateTime @db.Date
  steps  Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ───────────────────────── Engagement / AI ─────────────────────────
model Achievement {
  id          String   @id @default(uuid())
  userId      String
  code        String
  title       String
  description String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

model AIRecommendation {
  id        String             @id @default(uuid())
  userId    String
  type      RecommendationType
  date      DateTime?          @db.Date
  title     String?
  content   String
  metadata  Json?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, date])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
