NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fitai:fitai@localhost:5432/fitai?schema=public
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CLIENT_URL=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
ML_SERVICE_URL=http://localhost:8002
SUPABASE_URL=https://fhbfysakcowgjtcvhlwj.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables Gemini-powered coaching, chatbot, plan notes and food-photo recognition.
# Keep your key in this private, untracked backend/.env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Anthropic provider. Gemini takes precedence when both keys are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional SMTP for password-reset emails (otherwise the link is printed in the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FitAI <no-reply@fitai.local>

UPLOAD_DIR=uploads
SEED_ADMIN_PASSWORD=Admin@12345
# Optional JSON override for calorie/macro rules, e.g. {"goalAdjustments":{"WEIGHT_LOSS":-0.15}}
NUTRITION_OVERRIDES=
